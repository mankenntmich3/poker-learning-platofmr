{
  "name": "poker-learning-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "ranges:generate": "tsx scripts/nlhe.ts",
    "db:setup": "tsx scripts/local-db.ts setup",
    "db:migrate": "tsx scripts/local-db.ts migrate",
    "db:seed": "tsx scripts/local-db.ts seed",
    "db:reset": "tsx scripts/local-db.ts reset",
    "setup:local": "pnpm db:setup && pnpm db:seed",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "start:hosted": "node scripts/start-hosted.mjs",
    "db:migrate:hosted": "tsx scripts/migrate-hosted.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/domain tests/solver",
    "test:integration": "vitest run tests/server",
    "test:e2e": "playwright test",
    "test:dev-access": "playwright test --config playwright.dev.config.ts",
    "solve": "tsx scripts/solve.ts",
    "solve:nlhe": "tsx scripts/solve-nlhe.ts lp",
    "solve:nlhe:dcfr": "tsx scripts/solve-nlhe.ts",
    "solve:preflop": "tsx scripts/solve-preflop.ts",
    "solve:preflop:jobs": "tsx scripts/run-preflop-jobs.ts",
    "solve:preflop:attempt": "tsx scripts/attempt-preflop.ts",
    "solve:preflop:record-attempts": "tsx scripts/record-preflop-attempts.ts",
    "verify:preflop:deviations": "tsx scripts/verify-preflop-deviations.ts",
    "verify:nlhe": "tsx scripts/verify-nlhe.ts"
  },
  "dependencies": {
    "@next/env": "^16.3.4",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
