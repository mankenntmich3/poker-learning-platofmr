# No cloud accounts, external PostgreSQL installation or secrets needed locally.
# pnpm db:setup copies this file to .env.local without overwriting an existing file.
# Local preferred URL. In development, 127.0.0.1 also works with exact same-origin checks.
APP_ORIGIN=http://localhost:3000
# Optional isolated local database directory; never share it between app processes.
# DATA_DIR=.data/postgres
# To preview a production build locally without DATABASE_URL only:
# ALLOW_LOCAL_DB=1
# For staging/production, configure real PostgreSQL and secure HTTPS origin.
# DATABASE_URL=postgresql://user:password@localhost:5432/rangeform
# Hosted private staging only: require an owner-held invitation during signup.
# Configure these in the host's secret store, never copy a real value into Git.
# STAGING_MODE=true
# STAGING_INVITE_CODE=
# PORT is supplied by the host; start:hosted binds 0.0.0.0.
# On Render only, start:hosted defaults APP_ORIGIN to its RENDER_EXTERNAL_URL.
# Set an explicit APP_ORIGIN when using a custom domain or a different host.
# Dedicated disposable PostgreSQL for integration/browser tests only; never production.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/rangeform_test
# NODE_ENV is set by Next.js / the database CLI. Do not set it in this file.
# Demo access is restricted to NODE_ENV=development with no DATABASE_URL.
# No DEV_AUTH_BYPASS exists: the demo uses real password and session verification.
